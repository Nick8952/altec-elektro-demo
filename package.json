{
  "name": "altec-elektro-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/vercel-routen.mjs --entfernen && cross-env DEPLOY_TARGET=pages next dev",
    "dev:vercel": "node scripts/vercel-routen.mjs && cross-env DEPLOY_TARGET=vercel next dev",
    "build": "npm run build:pages",
    "build:pages": "node scripts/vercel-routen.mjs --entfernen && cross-env DEPLOY_TARGET=pages next build && node scripts/export-nachbereiten.mjs",
    "build:vercel": "node scripts/vercel-routen.mjs && cross-env DEPLOY_TARGET=vercel next build",
    "start": "node scripts/vorschau-server.mjs",
    "start:vercel": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "bilder": "node scripts/bilder-optimieren.mjs",
    "inhalte": "node werkzeuge/inhalte/gen.mjs",
    "inhalt:pruefen": "tsx scripts/inhalt-pruefen.mts",
    "seed": "tsx scripts/seed.mts",
    "vorschau:pages": "node scripts/vorschau-server.mjs",
    "export:pruefen": "node scripts/export-pruefen.mjs",
    "qa": "node werkzeuge/qa/audit.mjs && node werkzeuge/qa/funktionen.mjs",
    "pruefen": "npm run inhalt:pruefen && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^8.7.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/locale-de-de": "^1.1.37",
    "@sanity/vision": "^6.16.0",
    "next": "^16.3.6",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
